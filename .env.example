# Copy to .env and fill in real values. docker compose reads this file.
# Never commit .env to git.

# --- Security -------------------------------------------------------------
# When set, all /api/* routes require "Authorization: Bearer <token>".
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The token is also passed to the frontend build (VITE_API_TOKEN) so the review
# SPA can authenticate. Note: anyone who loads the SPA can read it — it is a
# shared workshop key, not per-user auth. Runtime override:
#   localStorage.setItem('cutlist_api_token', '...')
CUTLIST_API_TOKEN=

# --- AI features (optional) -------------------------------------------------
# Key from https://console.groq.com/keys. Switches on: describe in any language,
# voice notes, sketch photos, the plan assistant, tips and naming of unnamed parts.
GROQ_API_KEY=
# Model ids. Providers retire models; change these instead of the code.
# CUTLIST_AI_MODEL=openai/gpt-oss-120b
# CUTLIST_AI_VISION_MODEL=qwen/qwen3.8-27b
# CUTLIST_AI_SPEECH_MODEL=whisper-large-v3-turbo
# AI calls allowed per user per day (in memory, resets on restart).
# CUTLIST_AI_DAILY_LIMIT=200

# --- Database & SaaS (M1 foundation) -----------------------------------------
# Generate the JWT secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CUTLIST_JWT_SECRET=
# Generate a strong Postgres password too.
POSTGRES_PASSWORD=
# Leave unset to use the default SQLite file (dev). In docker-compose this is
# wired to Postgres automatically.
# CUTLIST_DATABASE_URL=postgresql+psycopg://cutlist:PASSWORD@db:5432/cutlist
# Where uploaded models + generated artifacts live
CUTLIST_STORAGE_DIR=data/storage
# Free-plan monthly job quota
CUTLIST_MONTHLY_JOB_LIMIT=50

# --- Email verification (M3) -------------------------------------------------
# Without SMTP settings the verification link is logged to the server console
# instead of being emailed (fine for dev).
CUTLIST_SMTP_HOST=
# 587 STARTTLS (default) or 465 SSL
CUTLIST_SMTP_PORT=587
CUTLIST_SMTP_USER=
CUTLIST_SMTP_PASSWORD=
# Defaults to the SMTP user when unset
CUTLIST_SMTP_FROM=
# Public base URL used in email + share links, e.g. https://cutlist.example.com
CUTLIST_APP_URL=

# --- Production limits ------------------------------------------------------
CUTLIST_MAX_UPLOAD_MB=100
CUTLIST_MAX_TRIANGLES=500000
CUTLIST_SESSION_TTL_HOURS=168

# --- Runtime ----------------------------------------------------------------
# Host port to expose
PORT=8000
# Workers: keep at 1 — session state + locks live in-process.
CUTLIST_WORKERS=1

# --- Public launch safety -----------------------------------------------------
# Sign-in, sign-up and password-reset attempts are limited per address (in memory).
# off = no limit (local use only).
# CUTLIST_RATE_LIMIT=on
# Behind nginx/Caddy on the same host or Docker network the client address is read
# from X-Forwarded-For automatically. 1 = always trust it, 0 = never.
# CUTLIST_TRUST_PROXY=
# Browser origins allowed to call the API, comma separated. Blank allows any
# (safe here: sign-in is by bearer token, not a cookie).
# CUTLIST_CORS_ORIGINS=https://cutlist.example.com
